   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Strip redundant onnxruntime stub framework"
               scriptText = "# onnxruntime is statically linked into the app; Xcode embeds an empty&#10;# binary-less stub framework that App Store rejects (ITMS-90208). Remove it&#10;# from the assembled archive. App Store distribution re-signs the bundle.&#10;for app in &quot;${ARCHIVE_PATH}/Products/Applications/&quot;*.app; do&#10;  for f in onnxruntime onnxruntime_extensions; do&#10;    if [ -d &quot;$app/Frameworks/$f.framework&quot; ]; then&#10;      echo &quot;Removing redundant $f.framework from archive&quot;&#10;      rm -rf &quot;$app/Frameworks/$f.framework&quot;&#10;    fi&#10;  done&#10;done&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "D51C5A932F6A2A1100A6D602"
                     BuildableName = "majiang calculator.app"
                     BlueprintName = "majiang calculator"
                     ReferencedContainer = "container:majiang calculator.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </ArchiveAction>
</Scheme>
