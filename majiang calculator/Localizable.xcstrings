        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the shot, your own tiles (including pongs and kongs) are framed automatically, leaving out other players' tiles and the discard pile. If the frame is off, drag a corner or an edge — or drag a new one anywhere on the photo."
          }
