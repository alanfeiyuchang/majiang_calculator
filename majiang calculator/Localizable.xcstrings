    "根" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Root"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根"
          }
        }
      }
    },
    "根 = 4 张同牌。默认「碰 + 手里第 4 张」「手握 4 张」也算根；开启「只有杠才算根」后仅明杠/暗杠算。加底/关闭时，杠只按刮风下雨即时结算，不再翻倍进胡牌金额。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Root = four identical tiles. By default a pong + 4th tile and four-in-hand also count; turn on “Only kongs count as root” to count exposed/concealed kongs only. On Add-base/Off, kongs settle instantly (wind/rain) and no longer double the win amount."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根 = 4 张同牌。默认「碰 + 手里第 4 张」「手握 4 张」也算根；开启「只有杠才算根」后仅明杠/暗杠算。加底/关闭时，杠只按刮风下雨即时结算，不再翻倍进胡牌金额。"
          }
        }
      }
    },
    "根 = 凑齐 4 张同牌（杠 / 手握 4 张 / 碰 + 第 4 张）。加底/关闭时，杠只按刮风下雨即时结算，不再翻倍进胡牌金额。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Root = four identical tiles (a kong, four in hand, or a pong + 4th tile). On Add-base/Off, kongs settle instantly (wind/rain) and no longer double the win amount."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根 = 凑齐 4 张同牌（杠 / 手握 4 张 / 碰 + 第 4 张）。加底/关闭时，杠只按刮风下雨即时结算，不再翻倍进胡牌金额。"
          }
        }
      }
    },
