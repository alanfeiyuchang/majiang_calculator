          }
        }
      }
    },
    "金额 = 底分 × 2^番数（封顶截断），为单家输赢：点炮由放炮者付，自摸三家各付。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount = base × 2^fan (capped), per opponent: on a discard win the discarder pays; on self-draw each of the three pays."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额 = 底分 × 2^番数（封顶截断），为单家输赢：点炮由放炮者付，自摸三家各付。"
          }
        }
      }
    },
    "金额为单家：点炮时放炮那家付这个数。点牌可看番型明细。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are per opponent: on a discard win the discarder pays this. Tap a tile for the fan breakdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额为单家：点炮时放炮那家付这个数。点牌可看番型明细。"
          }
        }
      }
    },
    "金额为单家：自摸后三家各付这个数。点牌可看番型明细。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amounts are per opponent: on self-draw each of the other three pays this. Tap a tile for the fan breakdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额为单家：自摸后三家各付这个数。点牌可看番型明细。"
          }
        }
      }
    },
    "门清": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concealed Hand"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门清"
          }
        }
      }
    },
    "门清 = 没有碰、没有明杠（暗杠可），点炮/自摸都算。断幺九 = 整副牌完全没有 1 和 9。七小对关闭后，七对牌型不计基础 2 番；豪华关闭则龙七对按平七小对计。将对 = 碰碰胡且全是 2/5/8（关闭时按普通碰碰胡/七小对计）。金钩钓已含碰碰胡，不叠加。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concealed Hand = no pong and no exposed kong (concealed kong OK); counts on both discard and self-draw. All Simples = no 1s or 9s anywhere. With Seven Pairs off, seven-pair hands score no base 2 fan; with Deluxe off, a dragon seven pairs scores as plain Seven Pairs. Jiang Pungs = All Pungs all 2/5/8 (off → scored as ordinary All Pungs / Seven Pairs). Golden Hook already includes All Pungs and does not stack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门清 = 没有碰、没有明杠（暗杠可），点炮/自摸都算。断幺九 = 整副牌完全没有 1 和 9。七小对关闭后，七对牌型不计基础 2 番；豪华关闭则龙七对按平七小对计。将对 = 碰碰胡且全是 2/5/8（关闭时按普通碰碰胡/七小对计）。金钩钓已含碰碰胡，不叠加。"
          }
        }
      }
    },
    "门清（+1 番）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concealed Hand (+1 fan)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门清（+1 番）"
          }
        }
      }
    },
