    "选入手牌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select hand tiles"
          }
        }
      }
    },
    "选牌后点「分析手牌」：手牌 3n+1 张算听牌/向听，3n+2 张给打牌建议；已碰、已杠的牌用底部「碰 / 明杠 / 暗杠」加到桌上。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After picking tiles, tap Analyze: a 3n+1 hand gives tenpai/shanten, a 3n+2 hand gives discard advice. Add ponged/konged tiles to the table with Pong / Exposed Kong / Concealed Kong below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选牌后点「分析手牌」：手牌 3n+1 张算听牌/向听，3n+2 张给打牌建议；已碰、已杠的牌用底部「碰 / 明杠 / 暗杠」加到桌上。"
          }
        }
      }
    },
